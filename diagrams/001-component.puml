@startuml 001-component
title 001 組件圖：畫面與流程原型

skinparam defaultFontName "PingFang TC"
skinparam componentStyle rectangle
skinparam nodesep 20
skinparam ranksep 60

package "頁面層（Presentation）" {
  component "AppRouter\n頁面切換" as Router
  component "MockModeBadge\n「模擬模式」標示" as Badge
  component "MockControlBar\n模擬控制列（FR-061）" as Bar

  package "老師端頁面" as TeacherPages {
    component "HomePage (Main)" as PMain
    component "TeacherLoginPage (T-Login)" as PLogin
    component "PickPage (T-Pick)" as PPick
    component "ImportPage\n(T-Import / T-ImportError)" as PImport
    component "SetupPage (T-Setup)" as PSetup
    component "ConsolePage\n(T-Lobby / T-Live / T-EndConfirm / T-QuestionEnd)" as PConsole
    component "TeacherResultsPage\n(T-Results / T-WriteBack)" as PTResults
  }

  package "學生端頁面" as StudentPages {
    component "JoinPage (S-Join)" as PJoin
    component "StudentPlayPage\n(S-Wait / S-Answer / S-Submitted / S-QuestionDone)" as PPlay
    component "StudentResultsPage (S-Results)" as PSResults
  }

  package "共用介面元件" {
    component "AppHeader" as CHeader
    component "QuestionProgress" as CProgress
    component "SubmissionTable" as CSubTable
    component "GroupGrid" as CGroups
    component "ConfirmDialog" as CDialog
    component "SheetPreview" as CPreview
    component "ErrorArea\n共通錯誤訊息區（FR-009）" as CError
    component "ActionBar\n底部動作列（RD-09）" as CAction
  }
}

package "介面層（Service Interfaces）" {
  component "AuthService" <<interface>> as IAuth
  component "GuidedNotesService" <<interface>> as INotes
  component "ActivityService" <<interface>> as IActivity
  component "SubmissionService" <<interface>> as ISub
  component "ResultService" <<interface>> as IResult
  component "PhaseMockControl" <<interface>> as IPhaseCtl
  component "JudgementMockControl" <<interface>> as IJudgeCtl
  component "TeammateMockControl" <<interface>> as ITeamCtl
  component "ValidationMockControl" <<interface>> as IValidCtl
  component "UnexpectedErrorMockControl" <<interface>> as IErrCtl
  component "MockChoicePrompt" <<interface>> as IChoice
  component "ServiceRegistry\n綁定介面與實作" as Registry
}

package "模擬實作（001 提供）" {
  component "MockAuthService (M1)" as MAuth
  component "MockGuidedNotesService (M2)" as MNotes
  component "MockActivityService (M3, M7)" as MActivity
  component "MockSubmissionService (M4, M5, M6)" as MSub
  component "MockResultService (M8)" as MResult
  component "MockFixtures\n固定的模擬資料" as Fixtures
  component "MockSession\n每個分頁的模擬狀態" as Session
}


Router --> PMain
Router --> PJoin
Router --> PLogin

PLogin ..> IAuth
PPick ..> IAuth
PPick ..> INotes
PImport ..> INotes
PSetup ..> IActivity
PConsole ..> IActivity
PConsole ..> ISub
PConsole ..> IResult
PTResults ..> IResult
PMain ..> IActivity
PJoin ..> IActivity
PPlay ..> IActivity
PPlay ..> ISub
PPlay ..> IResult
PSResults ..> IResult

PConsole --> CSubTable
PConsole --> CProgress
PConsole --> CGroups
PConsole --> CDialog
PTResults --> CDialog
PTResults --> CPreview
PImport --> CPreview
PImport --> CAction
PSetup --> CAction
PConsole --> CAction
PTResults --> CAction
PPlay --> CProgress
PJoin --> CGroups
TeacherPages --> CError
StudentPages --> CError

Badge ..> Registry : isMockMode()
Badge --> Bar
Bar ..> Registry : phaseControl / judgementControl /\nteammateControl / validation /\nunexpectedError controls / choicePrompt
Bar --> CDialog : 顯示模擬選擇器（M1、M2）
Router ..> CDialog : closeTopDialog()（FR-014）
Registry --> IAuth
Registry --> INotes
Registry --> IActivity
Registry --> ISub
Registry --> IResult
Registry --> IPhaseCtl
Registry --> IJudgeCtl
Registry --> ITeamCtl
Registry --> IValidCtl
Registry --> IErrCtl
Registry --> IChoice

MAuth -up-|> IAuth
MNotes -up-|> INotes
MActivity -up-|> IActivity
MSub -up-|> ISub
MResult -up-|> IResult
MActivity -up-|> IPhaseCtl
MSub -up-|> IJudgeCtl
MSub -up-|> ITeamCtl
MActivity -up-|> IValidCtl
MSub -up-|> IValidCtl
Session -up-|> IErrCtl
Session -up-|> IChoice
MAuth --> Session
MNotes --> Session
MActivity --> Session
MSub --> Session
MResult --> Session
MAuth --> Fixtures
MNotes --> Fixtures
MActivity --> Fixtures
MSub --> Fixtures
MResult --> Fixtures


note bottom of Fixtures
  頁面只依賴介面（原則 III）。
  後續子功能新增真正的實作取代模擬實作：
  002 → AuthService（取代 M1）
  003 → GuidedNotesService（取代 M2）
  004 → ActivityService（取代 M3、M7）
  005 → SubmissionService（取代 M4、M5、M6）
  006 → ResultService（取代 M8）
  後續子功能新增實作，只修改 ServiceRegistry 的綁定
  （組合根 createServiceRegistry），不修改 001 的頁面。
  所有頁面使用 ErrorArea 顯示非預期錯誤（FR-009）。
end note

@enduml
