@startuml 004-component
title 004 組件圖：活動與階段同步

skinparam defaultFontName "PingFang TC"
skinparam componentStyle rectangle
skinparam nodesep 25
skinparam ranksep 50

actor "老師" as Teacher
actor "學生（各組，每組可多個分頁）" as Student

package "前端（瀏覽器分頁）" {
  package "001 頁面（001 最終版；004 只套用組數規則與說明文字，REQ-ACT-23；D21 見 spec「需請 001 修改」C1）" #EEEEEE {
    component "HomePage (Main)\nJoinPage (S-Join)\nStudentPlayPage / StudentResultsPage\n（S-Wait「這一輪」：004 的說明文字）" as StudentPages
    component "TeacherLoginPage (T-Login)\nSetupPage (T-Setup：004 的組數規則與說明文字)\nConsolePage (T-Lobby「取消活動」/ T-Live / T-QuestionEnd)" as TeacherPages
    component "ActivityService" <<interface>> as IActivity
    component "createServiceRegistry()\n組合根：只改 activity 的綁定" as Registry
  }
  component "HttpActivityService\n（004，實作 ActivityService）" as HttpAct
  component "RealtimeClient\nSocket.IO client，只用 WebSocket\non / emitWithAck / onConnect\n（004 建立，005、006 共用）" as Realtime
  component "ApiClient / TeacherCredentialStore\n帶 Bearer 的 HTTP、老師憑證\n（002）" as Api002 #EEEEEE
}

package "shared" {
  component "activityRules\n組數 2–20、預設 6" as Rules
  component "activitySync\nActivitySnapshot（版本號 + Activity）\nGroupAck" as SyncTypes
}

package "伺服器（Fastify，唯一權威來源，原則 V）" {
  component "activityRoutes\nREST：建立、修改設定、取消、\n開放、結束" as Routes
  component "ActivityGateway\n在 002 的 app.io 上：students 房間、\n加入與離開組別" as Gateway
  component "ActivityManager\n活動規則與階段轉換" as Manager
  component "CommandQueue\n依抵達順序逐一處理\n（004 與 005 共用一條）" as Queue
  component "SequenceClock\n不倒退的時間" as Clock
  component "ActivityStore\n活動狀態 + 版本號" as Store
  component "GroupMembership\n學生身分 → 組別\ngroupOf(socket)；取消時清除" as Membership
  component "ActivityView\n依對象產生 Activity\n（學生版不含學習單資訊）" as View
  component "ActivityBroadcaster\n狀態改變後推送最新快照" as Broadcaster
}

package "其他子功能（伺服器）" #EEEEEE {
  component "app.requireTeacher\napp.io（只用 WebSocket、handshake 老師驗證、\nTEACHER_ROOM、socket.data.isTeacher）\nbuildApp、loggerOptions（002）" as Auth002
  component "ImportStore.latest()\n（003）" as Import003
  component "005 送出與判定" as Sub005
  component "006 結果與寫回" as Res006
}

Teacher --> TeacherPages
Student --> StudentPages
StudentPages ..> IActivity
TeacherPages ..> IActivity
TeacherPages ..> Rules : 組數範圍與預設\n（001 spec 交給 004 定義，004 套用）
Registry --> HttpAct : 綁定
HttpAct -up-|> IActivity
HttpAct --> Realtime : 推送、加入與離開組別
HttpAct --> Api002 : 老師的指令
Realtime ..> Api002 : TeacherCredentialStore.get()\n→ auth.teacherToken
HttpAct ..> SyncTypes

Api002 --> Routes : HTTP（Authorization: Bearer）
Realtime <--> Gateway : WebSocket\n（handshake auth：teacherToken 或 studentToken）

Routes ..> Auth002 : preHandler
Gateway ..> Auth002 : 使用 app.io、socket.data.isTeacher
Routes --> Manager
Gateway --> Manager : 加入、離開；\n連線時取 snapshot
Manager --> Queue : 每個指令都經過
Manager --> Store
Manager --> Membership
Manager --> Clock : 開放、結束時間
Manager ..> Import003 : 建立活動時取題目
Manager ..> Rules
Store <.. Broadcaster : subscribe
Broadcaster --> View
Broadcaster --> Membership : 各組人數
Broadcaster --> Gateway : emit activity:snapshot\n（TEACHER_ROOM、students 房間）

Sub005 ..> Queue : 送出、判定
Sub005 ..> Membership : groupOf(socket)
Sub005 ..> Manager : endQuestion(n)（接受後自動結束）
Sub005 ..> Store : 目前題號與開放時間
Sub005 ..> Clock
Res006 ..> Store : 題目清單、結束時間

note right of Queue
  建立、修改設定、取消、開放、結束、加入、離開，
  以及 005 的送出與判定，全部在同一條佇列
  以同步程式碼逐一處理（中間沒有 await）。
  網路推送在處理完之後才排程。
end note

note bottom of Broadcaster
  每份快照帶 ActivityStore 的版本號；
  前端只採用比手上更新的版本（REQ-ACT-14）。
  同一輪事件迴圈內有多次改變時只送最新一份。
  活動被取消時送 activity = null（版本照樣遞增）。
end note
@enduml
