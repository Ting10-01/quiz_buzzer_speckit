@startuml 004-class
title 004 類別圖：活動與階段同步

skinparam defaultFontName "PingFang TC"
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package "001 Entities 與介面（001 最終版，不修改）" #EEEEEE {
  enum ActivityPhase {
    NO_ACTIVITY
    PREPARING
    OPEN
    QUESTION_ENDED
    FINISHED
  }
  class Activity {
    groupCount: number
    phase: ActivityPhase
    currentQuestion: number [0..1]
    spreadsheet: Spreadsheet
    questions: Question[]
    groups: Group[]
  }
  class Group {
    number: number
    memberCount: number
  }
  class ActivitySettings {
    groupCount: number
  }
  class ValidationError {
    field: string
    message: string
  }
  class UnexpectedError {
    message: string
  }
  class Spreadsheet
  class Question
  interface ActivityService {
    +createActivity(settings: ActivitySettings): Promise<Activity | ValidationError>
    +updateSettings(settings: ActivitySettings): Promise<Activity | ValidationError>
    +cancelActivity(): Promise<void>
    +openQuestion(questionNumber: number): Promise<Activity>
    +endQuestion(questionNumber: number): Promise<Activity>
    +joinGroup(groupNumber: number): Promise<Activity>
    +leaveGroup(): Promise<void>
    +getCurrentActivity(): Promise<Activity | null>
    +onPhaseChange(listener: (activity: Activity [0..1]) => void): Unsubscribe
    +onActivityChange(listener: (activity: Activity) => void): Unsubscribe
  }
  class SetupPage <<001 頁面，004 套用規則>> {
    組數初始值、「−」「+」何時不可用
    「學生加入」說明文字
  }
  Activity --> ActivityPhase
  Activity "1" *-- "2..20" Group
  Activity --> Spreadsheet
  Activity "1" *-- "1..*" Question
}

package "shared（004 新增）" {
  class ActivitySnapshot {
    version: number
    activity: Activity [0..1]
  }
  class GroupAck {
    snapshot: ActivitySnapshot
    studentToken: string [0..1]
    error: {code, message} [0..1]
  }
  class activityRules <<constants>> {
    +GROUP_COUNT_MIN = 2
    +GROUP_COUNT_MAX = 20
    +GROUP_COUNT_DEFAULT = 6
  }
  ActivitySnapshot o-- "0..1" Activity
  GroupAck *-- ActivitySnapshot
  SetupPage ..> activityRules : REQ-ACT-23
}

package "frontend/src/services（004 新增）" {
  class HttpActivityService {
    -realtime: RealtimeClient
    -api: ApiClient
    -latest: ActivitySnapshot [0..1]
    -lastPhaseKey: string [0..1]
    +（ActivityService 的 10 個方法）
    -apply(snapshot: ActivitySnapshot): boolean
  }
  class RealtimeClient {
    -socket: Socket
    -connectedTeacherToken: string [0..1]
    -rejectedTeacherToken: string [0..1]
    +connect(): void
    +reconnect(): void
    +on<T>(event: string, listener: (payload: T) => void): Unsubscribe
    +onConnect(listener: () => void): Unsubscribe
    +emitWithAck<T>(event: string, payload: object): Promise<T>
    +studentToken(): string [0..1]
    +setStudentToken(token: string): void
  }
  class ApiClient <<002>> #EEEEEE {
    +request<T>(method: string, path: string, body: unknown [0..1]): Promise<T>
  }
  class ApiError <<002>> #EEEEEE {
    status: number
    code: string
    message: string
  }
  class TeacherCredentialStore <<002>> #EEEEEE {
    +get(): string [0..1]
  }
  ApiClient ..> ApiError : reject
  ApiClient ..> TeacherCredentialStore
  RealtimeClient ..> TeacherCredentialStore : auth.teacherToken
  HttpActivityService ..|> ActivityService
  HttpActivityService --> RealtimeClient
  HttpActivityService --> ApiClient
  HttpActivityService ..> ApiError : 原樣 reject
  HttpActivityService ..> ActivitySnapshot
  HttpActivityService ..> GroupAck
  HttpActivityService ..> UnexpectedError : reject（含 joinGroup 被拒絕）
}

package "server/src/activity（004 新增）" {
  class ActivityState {
    spreadsheet: Spreadsheet
    questions: Question[]
    groupCount: number
    phase: ActivityPhase
    currentQuestion: number [0..1]
    openedAt: Map<number, number>
    endedAt: Map<number, number>
  }
  class ActivityStore {
    -state: ActivityState [0..1]
    -version: number
    +current(): ActivityState [0..1]
    +version(): number
    +commit(next: ActivityState [0..1]): number
    +subscribe(listener: (version: number) => void): Unsubscribe
  }
  class GroupMembership {
    -groupByStudent: Map<string, number>
    -studentBySocket: Map<string, string>
    +attach(socket: SocketRef, studentToken: string [0..1]): void
    +detach(socket: SocketRef): void
    +groupOf(socket: SocketRef): number [0..1]
    +join(socket: SocketRef, groupNumber: number): string
    +leave(socket: SocketRef): void
    +memberCounts(groupCount: number): number[]
    +highestOccupiedGroup(): number
    +reset(): void
  }
  class SocketRef <<type>> {
    id: string
  }
  class CommandQueue {
    -running: boolean
    +run<T>(command: () => T): T
  }
  class SequenceClock {
    -last: number
    +stamp(): number
  }
  class ActivityManager {
    +createActivity(settings: ActivitySettings): ActivitySnapshot | ValidationError
    +updateSettings(settings: ActivitySettings): ActivitySnapshot | ValidationError
    +cancelActivity(): ActivitySnapshot
    +openQuestion(questionNumber: number): ActivitySnapshot
    +endQuestion(questionNumber: number): ActivitySnapshot
    +joinGroup(socket: SocketRef, groupNumber: number): GroupAck
    +leaveGroup(socket: SocketRef): GroupAck
    +snapshot(audience: Audience): ActivitySnapshot
  }
  class ActivityRuleError <<exception>> {
    code: string
    message: string
  }
  enum Audience {
    TEACHER
    PUBLIC
  }
  class ActivityView <<functions>> {
    +toActivity(state: ActivityState, counts: number[], audience: Audience): Activity
  }
  class ActivityBroadcaster {
    -io: Server
    -flushScheduled: boolean
    +start(): void
    -flush(): void
  }
  class ActivityGateway {
    +attach(io: Server): void
    -onConnection(socket: Socket): void
  }
  class activityRoutes <<Fastify plugin>> {
    POST /api/activity
    PUT /api/activity/settings
    DELETE /api/activity
    POST /api/activity/questions/:n/open
    POST /api/activity/questions/:n/end
  }

  ActivityStore o-- "0..1" ActivityState
  ActivityState --> ActivityPhase
  ActivityManager --> CommandQueue
  ActivityManager --> ActivityStore
  ActivityManager --> GroupMembership
  ActivityManager --> SequenceClock
  ActivityManager ..> ActivityView
  ActivityManager ..> ActivityRuleError : throws
  ActivityManager ..> activityRules
  ActivityBroadcaster --> ActivityStore : subscribe
  ActivityBroadcaster --> GroupMembership
  ActivityBroadcaster ..> ActivityView
  ActivityBroadcaster ..> ActivitySnapshot : emit activity:snapshot
  ActivityGateway --> ActivityManager
  ActivityGateway --> GroupMembership
  activityRoutes --> ActivityManager
  GroupMembership ..> SocketRef
  ActivityView ..> Audience
}

package "其他子功能" #EEEEEE {
  class ImportStore <<003>> {
    +latest(): ImportSuccess [0..1]
  }
  class "app.requireTeacher" as requireTeacher <<002 preHandler>>
  class "app.io" as appIo <<002 Socket.IO Server>> {
    TEACHER_ROOM = 'teacher'
    socket.data.isTeacher: boolean
  }
}

ActivityManager ..> ImportStore : createActivity 時
activityRoutes ..> requireTeacher
ActivityGateway ..> appIo
ActivityBroadcaster ..> appIo

note bottom of ActivityStore
  version 在每次 commit 遞增（從 1 開始），
  包含只有組別人數改變的 commit。
  subscribe 的 listener 在 commit 當下同步呼叫，
  只做排程，不做網路傳送。
  取消活動時 commit(null)，版本照樣遞增。
end note

note bottom of CommandQueue
  run() 同步執行 command 並回傳結果，
  command 內不得有 await。
  已在 run() 內時再呼叫 run() 直接就地執行
  （例如 005 的判定內呼叫 endQuestion）。
end note

note right of GroupMembership
  studentToken 由伺服器在第一次 join 時產生
  （crypto.randomBytes），前端存在 sessionStorage，
  重新連線時放在 handshake auth.studentToken。
  memberCounts 依 studentToken 計算，
  同一個 token 不重複計算（REQ-ACT-13）。
  reset() 在取消活動時清除所有組別對應，
  連線與 token 的對應保留（REQ-ACT-22）。
end note

note bottom of ActivityView
  PUBLIC：spreadsheet 換成空白的 Spreadsheet
  （id、title、selectedWorksheet 為空字串，
  worksheets 為空陣列，REQ-ACT-19）；
  兩種都不含任何送出資料。
  FINISHED 時 currentQuestion 為最後一題的題號。
end note
@enduml
