{
  "name": "@quiz-buzzer/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:load:activity": "tsx tests/load/phaseSync.load.ts --runs 20"
  },
  "dependencies": {
    "@googleapis/drive": "^27.1.0",
    "@googleapis/sheets": "^18.1.3",
    "@quiz-buzzer/shared": "*",
    "fastify": "^5.0.0",
    "google-auth-library": "^11.3.4",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
